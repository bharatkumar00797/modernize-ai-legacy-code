# Copy to .env (never commit it). Every variable is optional.

# LLM provider: "mock" (default, deterministic, offline, no key) or "openai"
# (any OpenAI-compatible endpoint: OpenAI, Groq, Ollama, vLLM, ...).
MODERNIZE_PROVIDER=mock
MODERNIZE_MODEL=gpt-4o-mini
MODERNIZE_BASE_URL=https://api.openai.com/v1
MODERNIZE_API_KEY=
MODERNIZE_LLM_TIMEOUT=30
MODERNIZE_LLM_RETRIES=2

# Let a real model propose unified diffs (still sandboxed + test-gated). Off by default.
MODERNIZE_ALLOW_MODEL_DIFFS=false

# Agent + sandbox limits
MODERNIZE_MAX_STEPS=20
MODERNIZE_TEST_TIMEOUT=60
MODERNIZE_ISOLATE_NETWORK=true
