# Copy to .env (never commit it). Every variable is optional.

# LLM provider: "mock" (default, deterministic, offline, no key) or "openai"
# (any OpenAI-compatible endpoint: OpenAI, Groq, Ollama, vLLM, ...).
MODERNIZE_PROVIDER=mock
MODERNIZE_MODEL=gpt-4o-mini
MODERNIZE_BASE_URL=https://api.openai.com/v1
MODERNIZE_API_KEY=
MODERNIZE_LLM_TIMEOUT=30
MODERNIZE_LLM_RETRIES=2

# Let a real model propose unified diffs (still sandboxed + test-gated). Off by default.
MODERNIZE_ALLOW_MODEL_DIFFS=false

# Agent + sandbox limits
MODERNIZE_MAX_STEPS=20
MODERNIZE_TEST_TIMEOUT=60
MODERNIZE_ISOLATE_NETWORK=true

# --- HTTP service (`modernize serve`) ---
# Comma-separated API keys. When set, every /api call needs X-API-Key or Bearer.
MODERNIZE_API_KEYS=
# No auth; meant for localhost only (`modernize serve --dev` also sets this).
MODERNIZE_DEV_MODE=false
# Comma-separated browser origins allowed to call the API (empty = same-origin only).
MODERNIZE_CORS_ORIGINS=
MODERNIZE_RATE_LIMIT_PER_MINUTE=120
MODERNIZE_RUN_LIMIT_PER_MINUTE=6
MODERNIZE_MAX_CONCURRENT_RUNS=2
MODERNIZE_MAX_QUEUED_RUNS=8
MODERNIZE_MAX_RUNS_KEPT=200
MODERNIZE_MAX_STEPS_CAP=40
# Trust the right-most X-Forwarded-For hop (only behind a known reverse proxy).
MODERNIZE_TRUST_PROXY=false
# Finish each run inside POST /api/runs (auto-on for Vercel / Lambda).
MODERNIZE_SYNC_RUNS=false
# Host port published by docker compose (container still listens on 8000).
MODERNIZE_HOST_PORT=8000
